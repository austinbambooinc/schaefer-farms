---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((item) => ({
    params: { slug: item.id },
  }));
}

const { slug } = Astro.params;
const entry = await getEntry("pages", slug);

if (!entry) {
  throw new Error("Page not found");
}

const { Content } = await render(entry);

const isBlogIndex = slug === "farm-news-and-updates";
const posts = isBlogIndex
  ? (await getCollection("blog")).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    )
  : [];
---

<BaseLayout
  title={entry.data.seo?.meta_title || entry.data.title}
  metaDescription={entry.data.seo?.meta_description}
  metaKeywords={entry.data.seo?.meta_keywords}
>
  <h1>{entry.data.title}</h1>

  {entry.data.description && <p><em>{entry.data.description}</em></p>}

  <hr />

  <Content />

  {isBlogIndex && posts.length > 0 && (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <br />
          <small>{post.data.date.toLocaleDateString()}</small>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>